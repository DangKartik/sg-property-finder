                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Client Layer\n    subgraph Client [\&quot;Client Layer (React.js + MUI + Leaflet.js)\&quot;]\n        UI_Profile[\&quot;ProfileFormUI / ProfileSelectorUI\&quot;]\n        UI_Results[\&quot;ResultsListUI\&quot;]\n        UI_Map[\&quot;NeighborhoodMapUI\&quot;]\n        UI_FactSheet[\&quot;FactSheetUI\&quot;]\n        UI_Export[\&quot;ExportReportUI\&quot;]\n        UI_Notify[\&quot;NotificationModalUI\&quot;]\n        LocalStore[(\&quot;IndexedDB Storage (Dexie.js)\&quot;)]\n    end\n\n    %% Backend Layer\n    subgraph API [\&quot;Backend API Layer (Python FastAPI)\&quot;]\n        subgraph Controls [\&quot;Control &amp; Logic Services\&quot;]\n            StartupCtrl[\&quot;SystemStartupControl\&quot;]\n            ProfileCtrl[\&quot;ProfileControl &amp; InputValidationControl\&quot;]\n            RankingCtrl[\&quot;RankingControl &amp; WeightedScoringStrategy\&quot;]\n            MapCtrl[\&quot;MapControl\&quot;]\n            CommuteCtrl[\&quot;CommuteControl\&quot;]\n            DetailsCtrl[\&quot;NeighborhoodDetailsControl\&quot;]\n            ReportCtrl[\&quot;ReportControl (WeasyPrint)\&quot;]\n            NotifierCtrl[\&quot;DataAvailabilityNotifier\&quot;]\n        end\n\n        subgraph Retrievals [\&quot;Retrieval &amp; Integration Hierarchy\&quot;]\n            AbstractRetrieval[\&quot;RetrievalControl (Abstract Base)\&quot;]\n            AmenityCtrl[\&quot;AmenityRetrievalControl\&quot;]\n            EnvCtrl[\&quot;EnvironmentalRetrievalControl\&quot;]\n            PricingCtrl[\&quot;HousePricingRetrievalControl\&quot;]\n            OneMapAdapter[\&quot;OneMapApiAdapter\&quot;]\n            DataGovAdapter[\&quot;DataGovSgAdapter\&quot;]\n        end\n    end\n\n    %% External Services\n    subgraph External [\&quot;External Data Services\&quot;]\n        OneMapAPI[\&quot;OneMap API (Search, Basemap, Routing)\&quot;]\n        DataGovAPI[\&quot;Data.gov.sg API (Resale Prices, Amenities, Environment)\&quot;]\n    end\n\n    %% UI to Storage &amp; Controls\n    UI_Profile &lt;--&gt; LocalStore\n    UI_Profile --&gt; ProfileCtrl\n    UI_Results --&gt; RankingCtrl\n    UI_Map --&gt; MapCtrl\n    UI_FactSheet --&gt; DetailsCtrl\n    UI_Export --&gt; ReportCtrl\n    ProfileCtrl -.-&gt; UI_Notify\n    DetailsCtrl -.-&gt; UI_Notify\n    ReportCtrl -.-&gt; UI_Notify\n\n    %% Control Flow\n    StartupCtrl --&gt; LocalStore\n    RankingCtrl --&gt; CommuteCtrl\n    RankingCtrl --&gt; LocalStore\n    MapCtrl --&gt; CommuteCtrl\n    DetailsCtrl --&gt; AmenityCtrl\n    DetailsCtrl --&gt; EnvCtrl\n    DetailsCtrl --&gt; PricingCtrl\n\n    %% Retrieval &amp; Adapters\n    AmenityCtrl -- Inherits --&gt; AbstractRetrieval\n    EnvCtrl -- Inherits --&gt; AbstractRetrieval\n    PricingCtrl -- Inherits --&gt; AbstractRetrieval\n\n    AbstractRetrieval --&gt; NotifierCtrl\n    AbstractRetrieval --&gt; DataGovAdapter\n    CommuteCtrl --&gt; OneMapAdapter\n    MapCtrl --&gt; OneMapAdapter\n\n    %% External API Connections\n    OneMapAdapter &lt;--&gt; OneMapAPI\n    DataGovAdapter &lt;--&gt; DataGovAPI&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="1l7z534JRkiyj54Uts-l-1">
