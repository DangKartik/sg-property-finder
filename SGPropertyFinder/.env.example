# Copy this file to `.env` and fill in local values. Never commit `.env`.

# --- OneMap -----------------------------------------------------------------
# Current OneMap API authentication uses an email/password token exchange.
# ONEMAP_API_KEY is reserved for a future key-based gateway; the token adapter
# uses ONEMAP_EMAIL and ONEMAP_PASSWORD.
ONEMAP_API_KEY=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_BASE_URL=https://www.onemap.gov.sg

# --- data.gov.sg ------------------------------------------------------------
# The API key is optional and only raises rate limits.
DATA_GOV_SG_API_KEY=
DATA_GOV_SG_BASE_URL=https://api-production.data.gov.sg
DATA_GOV_SG_REALTIME_BASE_URL=https://api-open.data.gov.sg/v2/real-time/api

# --- Application ------------------------------------------------------------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Refresh subzone/HDB snapshots from data.gov.sg after this many hours.
DATA_MAX_AGE_HOURS=24
